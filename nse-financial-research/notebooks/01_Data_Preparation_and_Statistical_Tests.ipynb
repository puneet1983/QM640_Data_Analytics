   "source": [
    "infer_features = ['PAT','REVENUE','FINANCE_COSTS','EPS_BASIC','OTHER_INCOME']\n",
    "infer = development.dropna(subset=infer_features+['target_growth_pct','COMPANY_KEY','INDEX_INDUSTRY']).copy()\n",
    "signed = np.sign(infer[infer_features])*np.log1p(infer[infer_features].abs())\n",
    "signed_sd = signed.std(ddof=0)\n",
    "assert (signed_sd>0).all()\n",
    "Z = (signed-signed.mean())/signed_sd\n",
    "controls = pd.get_dummies(pd.DataFrame({'industry':infer.INDEX_INDUSTRY,\n",
    "                                       'target_quarter':infer.target_q.astype(str)}),drop_first=True,dtype=float)\n",
    "design = pd.concat([pd.Series(1.,index=infer.index,name='Intercept'),Z,controls],axis=1)\n",
    "X=design.to_numpy(float); y=infer.target_growth_pct.to_numpy(float)\n",
    "assert np.linalg.matrix_rank(X)==X.shape[1], 'Rank-deficient regression; review controls'\n",
    "beta=np.linalg.lstsq(X,y,rcond=None)[0]; residual=y-X@beta\n",
    "V_company,G_company=cluster_covariance(X,residual,infer.COMPANY_KEY)\n",
    "V_quarter,G_quarter=cluster_covariance(X,residual,infer.target_q.astype(str))\n",
    "intersection=infer.COMPANY_KEY.astype(str)+'|'+infer.target_q.astype(str)\n",
    "V_intersection,_=cluster_covariance(X,residual,intersection)\n",
    "V_two_way=V_company+V_quarter-V_intersection\n",
    "financial_indices=np.arange(1,1+len(infer_features))\n",
    "joint=[]\n",
    "for label,V,df in [('company',V_company,G_company-1),('quarter',V_quarter,G_quarter-1),\n",
    "                    ('two_way',V_two_way,min(G_company,G_quarter)-1)]:\n",
    "    joint.append({'clustering':label,**joint_wald(beta,V,financial_indices,df)})\n",
    "rq1_joint=pd.DataFrame(joint)\n",
    "rq2=coefficient_table(beta,V_company,G_company-1,design.columns).iloc[financial_indices].copy()\n",
    "rq2['p_Holm']=holm_adjust(rq2.p)\n",
    "rq2['reject_Holm_05']=rq2.p_Holm<ALPHA\n",
    "rq2['quarter_cluster_p']=coefficient_table(beta,V_quarter,G_quarter-1,design.columns).iloc[financial_indices].p.to_numpy()\n",
    "rq2['two_way_p']=coefficient_table(beta,V_two_way,min(G_company,G_quarter)-1,design.columns).iloc[financial_indices].p.to_numpy()\n",
    "SSE=float(residual@residual); SST=float(((y-y.mean())**2).sum()); N,K=X.shape\n",
    "regression_summary=pd.Series({'complete_case_rows':N,'excluded_development_rows':len(development)-N,\n",
    " 'company_clusters':G_company,'quarter_clusters':G_quarter,'parameters_including_controls':K,\n",
    " 'R_squared_in_sample':1-SSE/SST,'adjusted_R_squared':1-(SSE/(N-K))/(SST/(N-1)),\n",
    " 'target_quarter_first':str(infer.target_q.min()),'target_quarter_last':str(infer.target_q.max())})\n",
    "display(regression_summary); display(rq1_joint); display(rq2)\n",
    "rq1_joint.to_csv(STATS_OUTPUT/'RQ1_joint_financial_test.csv',index=False)\n",
    "rq2.to_csv(STATS_OUTPUT/'RQ2_coefficient_tests.csv',index=False)\n",
    "regression_summary.to_csv(STATS_OUTPUT/'regression_summary.csv')"
   ]
