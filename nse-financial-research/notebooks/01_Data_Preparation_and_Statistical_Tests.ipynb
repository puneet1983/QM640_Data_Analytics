   "source": [
    "vifs=[]\n",
    "for j in financial_indices:\n",
    "    other=np.delete(X,j,axis=1); xj=X[:,j]\n",
    "    rj=xj-other@np.linalg.lstsq(other,xj,rcond=None)[0]\n",
    "    r2j=1-float(rj@rj)/float(((xj-xj.mean())**2).sum())\n",
    "    vifs.append({'predictor':design.columns[j],'VIF':1/max(1-r2j,1e-15)})\n",
    "vif_table=pd.DataFrame(vifs); display(vif_table)\n",
    "aux=np.column_stack([np.ones(N),Z.to_numpy(float)])\n",
    "e2=residual**2\n",
    "aux_res=e2-aux@np.linalg.lstsq(aux,e2,rcond=None)[0]\n",
    "aux_r2=1-float(aux_res@aux_res)/float(((e2-e2.mean())**2).sum())\n",
    "bp_lm=N*aux_r2\n",
    "diagnostics=pd.Series({'BP_LM_iid_reference':bp_lm,'BP_df':len(infer_features),\n",
