       "revenue_growth_pct              100*(REVENUE-REVENUE_lag1)/abs(REVENUE_lag1)\n",
       "eps_basic_growth_pct       100*(EPS_BASIC-EPS_BASIC_lag1)/abs(EPS_BASIC_l...\n",
